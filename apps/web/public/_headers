# Real-CUGAN runs on multiple threads, which requires SharedArrayBuffer and
# therefore a cross-origin isolated document. These headers are copied into the
# build output and applied by Cloudflare Workers static assets.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Vite fingerprints everything under /assets, so it is safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The wasm artifacts are not content-hashed; revalidate daily.
/wasm/*
  Cache-Control: public, max-age=86400
